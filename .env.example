# The `draft` command needs ONE of these providers configured.
# Priority: DRAFT_PROVIDER if set, else anthropic key, else openai key, else local ollama.
DRAFT_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_DRAFT_MODEL=gpt-4o
OLLAMA_DRAFT_MODEL=llama3.2

# Optional: only needed for the Adzuna source. Get a free key at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Disabled by default: Adzuna is an aggregator, so its links are discovery-only and
# are hidden from the actionable board. Set true only if you want it for research.
ENABLE_ADZUNA=false
# RemoteOK and We Work Remotely are also discovery sources. Keep them off the active
# application board by default; direct company boards are more reliable.
ENABLE_DISCOVERY_FEEDS=false

# Optional: override the local Ollama models used for matching
OLLAMA_RANK_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: private Telegram companion. Keep these values only in .env — never commit them.
# 1. Create a bot via @BotFather and set TELEGRAM_BOT_TOKEN.
# 2. Run `jobagent telegram run`, message the bot /start, and copy the chat ID it returns.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# Your private Tailscale dashboard URL, e.g. http://100.x.y.z:8842
TELEGRAM_DASHBOARD_URL=
TELEGRAM_MIN_SCORE=8

# Application preparation is stricter than Telegram review: only Ready/drafted roles scored
# 9+ with explicitly confirmed worldwide remote work or visa sponsorship enter this queue.
AUTOPILOT_MIN_SCORE=9
AUTOPILOT_BATCH_SIZE=5
# Set true only if you want to prepare unknown-eligibility roles outside the US/UK.
# They still stop before submission if sponsorship/right-to-work is unclear.
AUTOPILOT_INCLUDE_UNKNOWN_OUTSIDE_US_UK=false
# Keep aggregators such as Adzuna/RemoteOK as discovery only; apply only from direct ATS boards.
AUTOPILOT_REQUIRE_DIRECT_ATS=true

# Optional recruiter outreach delivery. Drafts are always reviewed first; setting these does
# not enable automatic sending. For Gmail use an app password, never your normal password.
OUTREACH_SMTP_HOST=
OUTREACH_SMTP_PORT=465
OUTREACH_SMTP_USERNAME=
OUTREACH_SMTP_PASSWORD=
OUTREACH_FROM_EMAIL=
