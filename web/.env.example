# Explicitly opt into the new multi-user beta. Omit or set to "founder" to keep
# the existing personal dashboard unchanged.
VITE_APP_MODE=beta

# Browser-safe Supabase values from Project Settings → API. These are public
# identifiers protected by Supabase Row Level Security; never put a service-role
# key in this file or any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
