# Runtime-only server configuration. Copy to /etc/job-pursuit/web.env, mode 600.
# Do not put any of these server secrets in frontend build arguments.
MOBILE_SUPABASE_URL=https://PROJECT.supabase.co
MOBILE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
MOBILE_LLM_PROVIDER=openai
MOBILE_OPENAI_MODEL=gpt-4.1
OPENAI_API_KEY=REPLACE_SERVER_SIDE_ONLY
# Keep an explicit invite list during acceptance. Empty means nobody; deleting
# the variable means public authenticated access, still subject to DB membership.
MOBILE_ALLOWED_EMAILS=approved-test-account@example.test
MOBILE_BILLING_PROVIDER=disabled
MOBILE_BILLING_MODE=test
MOBILE_BILLING_CHECKOUT_ENABLED=false
MOBILE_BILLING_LIVE_CHECKOUT_ENABLED=false
MOBILE_BILLING_LIVE_ACTIVATION_APPROVED=false

# Billing adapters support separate Stripe test and approval-gated live modes.
# Offline adapter tests are NOT proof of hosted SQL or Stripe acceptance. Keep
# billing disabled until reviewed migrations and provider setup are verified.
# Existing manual memberships do not depend on these settings and are never
# adopted or overwritten by billing; a disabled manual row is still manual.
# The new customer routes need 0013_billing_customer_flow.sql (after 0009/0010).
# Live additionally needs 0014_billing_live_activation.sql. This migration creates
# a DISABLED service-only mobile_billing_live_control record; it does not activate
# payments. Do not expose service keys or activation controls to the browser.

# Sandbox setup: set MOBILE_BILLING_PROVIDER=stripe, keep MODE=test, then enable
# CHECKOUT_ENABLED only for approved sandbox acceptance. No live-key fallback.
# Configure a fixed recurring, per-unit, licensed Price: quantity 1, monthly or
# yearly, interval_count=1, no trial/metering/tiers. Supported price currencies:
# USD, EUR, GBP, AED, INR, CAD, AUD, SGD. Prices are read from Stripe, not this file.
# Caps below are illustrative units, NOT prices or approved launch allowances.
# MOBILE_BILLING_PLANS={"career":{"price_id":"price_REPLACE","display_name":"Reviewed plan name","period_limit":100,"daily_limit":10}}
# MOBILE_BILLING_STRIPE_SECRET_KEY=sk_test_REPLACE
# MOBILE_BILLING_STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# MOBILE_BILLING_STRIPE_PORTAL_CONFIGURATION=bpc_REPLACE
# MOBILE_BILLING_SUCCESS_URL=https://www.thejobpursuit.com/beta?billing=return
# MOBILE_BILLING_CANCEL_URL=https://www.thejobpursuit.com/beta?billing=cancelled
# MOBILE_BILLING_PORTAL_RETURN_URL=https://www.thejobpursuit.com/beta?billing=return
# Portal: active; subscription_update.enabled=false; subscription_cancel.enabled
# =true and mode=at_period_end. Disable customer emails during synthetic testing.
# Webhook: HTTPS /api/mobile/billing/webhook, endpoint API version 2024-06-20,
# platform events (not Connect), signed with this mode's own webhook secret.
# Subscribe to: customer.subscription.created/updated/deleted/paused/resumed/
# pending_update_applied/pending_update_expired; invoice.paid/payment_failed/
# payment_action_required/voided/marked_uncollectible/updated;
# checkout.session.completed/expired; charge.refunded/updated.
# A return URL selects the billing view only; it never proves payment.

# Trusted billing store: supply BOTH of this pair, only if not already reusing
# the approved MOBILE_PRIVACY_SUPABASE_URL + MOBILE_PRIVACY_SUPABASE_SECRET_KEY
# pair. Leaving these commented permits that pairwise fallback; blank overrides
# do not. These must address the same project as the verified customer identity.
# MOBILE_BILLING_SUPABASE_URL=https://PROJECT.supabase.co
# MOBILE_BILLING_SERVICE_ROLE_KEY=REPLACE_SERVER_SIDE_ONLY

# Live deployment is a separate, reviewed action -- do NOT enable for QA.
# Requires owner-approved pricing/caps/policies, SQL + sandbox acceptance, and
# BOTH LIVE_ACTIVATION_APPROVED=true AND a reviewed enabled DB control record
# (enabled, reviewed_at, review_reference). Keep the defaults above false now.
# Set MODE=live only during that approved activation. All live keys/catalog/
# redirects below are separate: test values are NEVER used as fallback.
# MOBILE_BILLING_LIVE_PLANS={"career":{"price_id":"price_REPLACE","display_name":"Reviewed plan name","period_limit":100,"daily_limit":10}}
# MOBILE_BILLING_STRIPE_LIVE_SECRET_KEY=sk_live_REPLACE
# MOBILE_BILLING_STRIPE_LIVE_WEBHOOK_SECRET=whsec_REPLACE
# MOBILE_BILLING_STRIPE_LIVE_PORTAL_CONFIGURATION=bpc_REPLACE
# MOBILE_BILLING_LIVE_SUCCESS_URL=https://www.thejobpursuit.com/beta?billing=return
# MOBILE_BILLING_LIVE_CANCEL_URL=https://www.thejobpursuit.com/beta?billing=cancelled
# MOBILE_BILLING_LIVE_PORTAL_RETURN_URL=https://www.thejobpursuit.com/beta?billing=return
# To pause NEW checkouts after launch, set LIVE_CHECKOUT_ENABLED=false; preserve
# reviewed activation so existing customers can reconcile/manage cancellation.
# Turning off checkout does not cancel existing Stripe subscriptions/renewals.
# Existing sandbox billing accounts cannot silently convert to live accounts;
# review their provider state separately, never remap customer IDs automatically.
